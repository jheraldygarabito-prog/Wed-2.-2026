# Configuración de base de datos
# Elige el tipo: mysql, postgres (para Supabase), o mssql (para SQL Server)
DB_TYPE=postgres  # Cambia a 'mysql' o 'mssql' según necesites

# Para MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_password_mysql
DB_NAME=tu_base_datos
DB_PORT=3306

# Para PostgreSQL / Supabase
# Para PostgreSQL / Supabase (copia la URI completa de Connection pooling)
DATABASE_URL=postgresql://postgres:Alina12686130@db.qbmggmwqjlkdtnmslryh.supabase.co:6543/postgres


# Para SQL Server
# DB_HOST=localhost
# DB_USER=sa
# DB_PASSWORD=tu_password_sqlserver
# DB_NAME=tu_base_datos
# DB_PORT=1433

# Para guardar tambien en SQL Server
SQLSERVER_SYNC_ENABLED=true
SQLSERVER_HOST=localhost
SQLSERVER_USER=doguito_user
SQLSERVER_PASSWORD=Alina12686130
SQLSERVER_DB=doguito
SQLSERVER_PORT=1433

# Para guardar tambien en MySQL / XAMPP
MYSQL_SYNC_ENABLED=true
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=doguito
